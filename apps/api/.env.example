# Copy to .env for local development. Never commit .env.
PORT=3000
LOG_LEVEL=info
# Pooled connection string of your Neon development branch (or a local PostgreSQL database).
# Use sslmode=verify-full with Neon.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full
# Signs session tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Password for the demo HR users created by npm run db:seed (at least 12 characters).
SEED_HR_PASSWORD=
# Web app address, used in links in emails.
APP_URL=http://localhost:5173
# console writes emails to the log; brevo sends them (needs a key and a verified sender).
EMAIL_TRANSPORT=console
BREVO_API_KEY=
EMAIL_FROM=
# Secret for the daily exchange rate refresh from GitHub Actions (at least 32 characters).
# Leave empty to switch that endpoint off; global HR users can still refresh by hand.
RATES_REFRESH_SECRET=
