# Copy to .env for local development. Never commit .env.
PORT=3000
LOG_LEVEL=info
# Pooled connection string of your Neon development branch (or a local PostgreSQL database).
# Use sslmode=verify-full with Neon.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full
# Signs session tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
